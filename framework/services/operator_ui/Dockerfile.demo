FROM python:3.12-slim
WORKDIR /app
RUN useradd --create-home --uid 10001 aimec
COPY framework/common/aimec_http.py framework/common/aimec_task_store.py /app/common/
COPY framework/services/operator_ui/webmcp.py framework/services/operator_ui/capability_jobs.py framework/services/operator_ui/demo_server.py /app/
COPY framework/services/operator_ui/public/demo.html framework/services/operator_ui/public/demo.css framework/services/operator_ui/public/demo.js framework/services/operator_ui/public/webmcp.js /app/public/
COPY framework/deploy/bc092/build-identity.json /app/build-identity.json
ENV PYTHONPATH=/app/common PYTHONUNBUFFERED=1
USER 10001:10001
CMD ["python", "/app/demo_server.py"]
