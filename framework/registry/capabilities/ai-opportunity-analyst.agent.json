{
  "schema_version": "0.1",
  "kind": "agent",
  "identity": {"id": "aimec.ai-opportunity-analyst", "display_name": "AIMEC AI Opportunity Analyst", "description": "Tool-grounded business analyst that evaluates an AI opportunity with AIMEC diagnostics, then hands a qualified case to the solution architect."},
  "version": "0.1.0",
  "provenance": {"repository": "https://github.com/AimecLabs/aimec_local_agent_harness", "commit": "baedf5710d29f121d4593c1926f52f444e212fcd", "publisher": "AIMEC"},
  "capabilities": ["business.analyze_opportunity"],
  "transport": {"protocol": "a2a", "endpoint_env": "AIMEC_CAPABILITY_AI_OPPORTUNITY_ANALYST_URL", "health_path": "/health"},
  "operations": [{
    "id": "business.analyze_opportunity", "action": "delegate", "capability": "business.analyze_opportunity", "timeout_seconds": 420,
    "input_schema": {
      "type": "object", "additionalProperties": false,
      "required": ["business_problem", "roi", "cost", "data_readiness", "agentic_readiness", "ai_readiness"],
      "properties": {
        "business_problem": {"type": "string", "maxLength": 4000},
        "roi": {"type": "object", "additionalProperties": false, "required": ["employees", "hours_per_week", "hourly_cost", "automation_percentage"], "properties": {"employees": {"type": "integer"}, "hours_per_week": {"type": "number"}, "hourly_cost": {"type": "number"}, "automation_percentage": {"type": "number"}, "monthly_ai_cost": {"type": "number"}, "implementation_cost": {"type": "number"}}},
        "cost": {"type": "object", "additionalProperties": false, "required": ["users", "requests_per_user_per_day", "tokens_per_request", "cost_per_million_tokens", "monthly_infrastructure_cost"], "properties": {"users": {"type": "integer"}, "requests_per_user_per_day": {"type": "number"}, "tokens_per_request": {"type": "integer"}, "cost_per_million_tokens": {"type": "number"}, "monthly_infrastructure_cost": {"type": "number"}}},
        "data_readiness": {"type": "object", "additionalProperties": false, "required": ["crm_data_quality", "documentation_quality", "api_availability", "data_accuracy", "security_controls", "data_ownership"], "properties": {"crm_data_quality": {"type": "integer"}, "documentation_quality": {"type": "integer"}, "api_availability": {"type": "integer"}, "data_accuracy": {"type": "integer"}, "security_controls": {"type": "integer"}, "data_ownership": {"type": "integer"}}},
        "agentic_readiness": {"type": "object", "additionalProperties": false, "required": ["api_access", "process_repeatability", "approval_points", "knowledge_documentation", "business_data_access", "automation_maturity"], "properties": {"api_access": {"type": "integer"}, "process_repeatability": {"type": "integer"}, "approval_points": {"type": "integer"}, "knowledge_documentation": {"type": "integer"}, "business_data_access": {"type": "integer"}, "automation_maturity": {"type": "integer"}}},
        "ai_readiness": {"type": "object", "additionalProperties": false, "required": ["strategy_clarity", "data_quality_accessibility", "process_documentation", "tools_integrations", "security_privacy", "team_readiness"], "properties": {"strategy_clarity": {"type": "integer"}, "data_quality_accessibility": {"type": "integer"}, "process_documentation": {"type": "integer"}, "tools_integrations": {"type": "integer"}, "security_privacy": {"type": "integer"}, "team_readiness": {"type": "integer"}}}
      }
    },
    "output_schema": {"type": "object", "additionalProperties": false, "required": ["model", "agent", "tool_calls", "analyst_assessment", "architect_handoff", "business_case", "directional_notice"], "properties": {"model": {"type": "string"}, "agent": {"type": "string"}, "tool_calls": {"type": "array", "maxItems": 8, "items": {"type": "object"}}, "analyst_assessment": {"type": "object"}, "architect_handoff": {"type": "object"}, "business_case": {"type": "object"}, "directional_notice": {"type": "string"}}}
  }],
  "permissions": {"network": "restricted", "filesystem": "none", "actions": ["read", "analyze", "delegate"]},
  "risk": {"level": "low", "human_gate": "review", "irreversible": false},
  "credentials": {"required": false, "env_refs": []},
  "data_policy": {"input_classes": ["public"], "output_classes": ["local"], "retention": "ephemeral", "crosses_node_boundary": true},
  "health": {"mode": "transport", "interval_seconds": 30},
  "delegation": {"accepts_tasks": true, "can_delegate": true, "max_hops": 1},
  "evaluation": {"suite": "bc094-business-agent-demo", "passed": true, "evidence": ["urn:aimec:bc094:local-acceptance"]},
  "approval": {"state": "submitted"},
  "commercial": {"role": "business opportunity analysis", "model_runtime": "local Ollama"}
}
